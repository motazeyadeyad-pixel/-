<!DOCTYPE html>
<html lang="ar">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>متجر موسيقاتي</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    background:#0f0f0f;
    font-family:Tahoma;
    direction:rtl;
    color:white;
    padding-top:260px;
}

header{
    width:100%;
    background:#151515;
    padding:10px;
    text-align:center;
    box-shadow:0 0 20px rgba(0,0,0,0.5);
    position:fixed;
    top:0;
    right:0;
    z-index:999;
}

.top-logo{
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
}

.top-logo img{
    width:65px;
    height:65px;
    border-radius:50%;
    object-fit:cover;
    margin-bottom:10px;
}

.top-logo h1{
    color:#00ffd0;
    font-size:30px;
}

.top-links{
    display:flex;
    justify-content:center;
    gap:35px;
    margin-top:25px;
    border-top:2px solid #333;
    padding-top:20px;
}

.top-links a img{
    width:150px;
    height:auto;
    border-radius:10px;
    transition:0.3s;
}

.top-links a img:hover{
    transform:scale(1.08);
}

.top-links a:hover{
    color:#00ffd0;
}

.menu{
    position:absolute;
    top:25px;
    right:25px;
}

.menu-btn{
    background:#00ffd0;
    color:black;
    border:none;
    font-size:28px;
    padding:8px 16px;
    border-radius:10px;
    cursor:pointer;
}

.menu-content{
    display:none;
    position:absolute;
    right:0;
    top:55px;
    background:#1d1d1d;
    width:260px;
    border-radius:15px;
    overflow:hidden;
    box-shadow:0 0 15px rgba(0,0,0,0.5);
}

.menu-content a{
    display:flex;
    align-items:center;
    gap:12px;
    color:white;
    padding:15px;
    text-decoration:none;
    transition:0.3s;
}

.menu-content a:hover{
    background:#00ffd0;
    color:black;
}
.menu-content a img{
    width:90px;
    height:55px;
    object-fit:contain;
    background:#111;
    padding:5px;
    border-radius:10px;
}

.about-title{
    text-align:center;
    margin-top:60px;
    color:#00ffd0;
    font-size:38px;
}

.about-store{
    width:80%;
    margin:auto;
    margin-top:25px;
    text-align:center;
    color:#ddd;
    font-size:22px;
    line-height:2;
}

.categories-section{
    width:90%;
    margin:auto;
    margin-top:80px;
    margin-bottom:80px;
}

.section-title{
    text-align:center;
    color:#00ffd0;
    margin-bottom:35px;
    font-size:38px;
}

.categories-container{
    display:flex;
    justify-content:center;
    gap:25px;
    flex-wrap:wrap;
}

.category-card{
    width:240px;
    background:#1d1d1d;
    border-radius:20px;
    overflow:hidden;
    text-align:center;
    text-decoration:none;
    transition:0.4s;
    box-shadow:0 0 20px rgba(0,0,0,0.5);
}

.category-card:hover{
    transform:translateY(-10px) scale(1.03);
}

.category-card img{
    width:100%;
    height:170px;
    object-fit:contain;
    background:#111;
    padding:10px;
}


.category-card h3{
    padding:18px;
    color:white;
    font-size:24px;
}

.footer{
    width:100%;
    background:rgb(146, 113, 3);
    margin-top:80px;
    padding:35px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    flex-wrap:wrap;
}

.footer-right{
    color:black;
    text-align:right;
    line-height:2.2;
}

.footer-right h2{
    margin-bottom:15px;
    font-size:32px;
}

.footer-right p{
    font-size:20px;
}

.footer-social{
    display:flex;
    gap:20px;
}

.footer-social img{
    width:55px;
    height:55px;
    border-radius:15px;
    transition:0.3s;
}

.footer-social img:hover{
    transform:scale(1.1);
}

.social-title{
    width:100%;
    text-align:center;
    color:black;
    margin-bottom:15px;
    font-size:28px;
}

.location-link{
    color:black;
    text-decoration:none;
    transition:0.3s;
}

.location-link:hover{
    color:white;
}
.section-title{
    text-align:center;
    margin-top:60px;
    font-size:32px;
    color:#00ffd0;
}

.popular-products{
    width:85%;
    margin:30px auto;
    display:grid;
    grid-template-columns:repeat(4, 1fr);
    gap:20px;
}

.popular-card{
    background:#1d1d1d;
    border-radius:15px;
    padding:15px;
    text-align:center;
    transition:0.3s;
}

.popular-card:hover{
    transform:scale(1.05);
}

.popular-card img{
    width:100%;
    height:150px;
    object-fit:contain;
    border-radius:10px;
}

.popular-card h3{
    margin-top:10px;
    font-size:18px;
}

.popular-card p{
    color:#00ffd0;
    margin-top:5px;
}
.popular-link{
    text-decoration:none;
    color:white;
}

.popular-btn{
    margin-top:12px;
    padding:10px 25px;
    border:none;
    border-radius:10px;
    background:#00ffd0;
    color:black;
    font-size:16px;
    cursor:pointer;
    transition:0.3s;
}

.popular-btn:hover{
    transform:scale(1.08);
    background:white;
}
</style>

</head>

